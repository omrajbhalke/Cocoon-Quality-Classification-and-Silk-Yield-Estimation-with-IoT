# ──────────────────────────────────────────────────────────
# Additional Safe Ignores
# ──────────────────────────────────────────────────────────

# Don't commit large video/image files (use Git LFS if needed)
*.mp4
*.avi
*.mov
*.wmv

# Cache
.cache/
*.cache

# Backup files
*.backup
*.bak
*.backup.*
